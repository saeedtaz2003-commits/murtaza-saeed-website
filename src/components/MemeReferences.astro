---
const { item, showDisclosure = true } = Astro.props;
const showReferences = !item.hideCommentaryReferences;
---
{showReferences && item.sources?.length && <div class="meme-references">Sources: {item.sources.map((source, index) => <>{index > 0 && ' · '}<a href={source.url} target="_blank" rel="noopener noreferrer">{source.label}</a></>)}</div>}
{showReferences && showDisclosure && item.illustrationDisclosure && <div class="meme-illustration-note">{item.illustrationDisclosure}</div>}
