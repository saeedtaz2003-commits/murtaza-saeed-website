---
import { previewExcerpt } from '../utils/article-preview.mjs';
import BrandText from './BrandText.astro';
const { post, featured = false, compact = false, hideCategory = false, trailingSlash = false } = Astro.props;
const articleHref = `/${post.data.slug}${trailingSlash ? '/' : ''}`;
const dateLabel = `${post.data.updated ? 'Last updated: ' : 'Published: '}${(post.data.updated ?? post.data.date).toLocaleDateString('en-GB', { day:'numeric', month:'long', year:'numeric', timeZone:'UTC' })}`;
const insightsCardSlugs = new Set(['from-paper-to-erp-ai-finance-function', 'can-cutting-prices-improve-your-business-performance', 'dont-invent-it-technify-it']);
const thumbnailImage = insightsCardSlugs.has(post.data.slug) && post.data.articleHero?.image ? post.data.articleHero.image : post.data.image;
const thumbnailAlt = insightsCardSlugs.has(post.data.slug) && post.data.articleHero?.alt ? post.data.articleHero.alt : post.data.imageAlt;
const contentLabel = post.data.advertorial
  ? `ADVERTORIAL${post.data.sponsor ? ` · Sponsored by ${post.data.sponsor}` : ''}`
  : post.data.category;
---
{compact ? (
  <article class:list={['archive-card', { 'archive-card-advertorial': post.data.advertorial }]}>
    <a class="archive-thumb" href={articleHref} aria-label={`Read ${post.data.title}`}>
      <img src={thumbnailImage} alt={thumbnailAlt} loading="lazy" />
    </a>
    <div class="archive-copy">
      <p class="eyebrow">{!hideCategory && <>{contentLabel} · </>}{dateLabel}</p>
      <h2><a href={articleHref}>{post.data.title}</a></h2>
      <p class="archive-summary"><BrandText text={previewExcerpt(post)} /></p>
      <a class="read" href={articleHref}>{post.data.advertorial ? 'Read Advertorial' : 'Read Article'} </a>
    </div>
  </article>
) : (
  <article class:list={['card', { featured, 'card-advertorial': post.data.advertorial }]}>
    <a class="card-image" href={articleHref}><img src={thumbnailImage} alt={thumbnailAlt} loading={featured ? 'eager' : 'lazy'} /></a>
    <div class="card-copy">
      <p class="eyebrow">{contentLabel} · {dateLabel}</p>
      <h2><a href={articleHref}>{post.data.title}</a></h2>
      <p><BrandText text={previewExcerpt(post)} /></p>
      <a class="read" href={articleHref}>{post.data.advertorial ? 'Read Advertorial' : 'Read Article'} </a>
    </div>
  </article>
)}
