---
const { sources = [] } = Astro.props;
---
{sources.length > 0 && <details class="article-sources" id="sources-references">
  <summary>Sources &amp; References</summary>
  <ul>{sources.map(source => <li>{source.url ? <a href={source.url} target="_blank" rel="noopener noreferrer">{source.text}</a> : source.text}</li>)}</ul>
</details>}
