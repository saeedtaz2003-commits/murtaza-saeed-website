---
import SiteSearch from './SiteSearch.astro';
const path = Astro.url.pathname;
const links = [
  ['Home', '/'], ['About', '/about'], ['Insights', '/insights'],
  ['Biz Buzz', '/the-lighter-side'], ['Work With Me', '/work-with-me'], ['Contact', '/contact']
];
---
<header class="site-header">
  <div class="topbar wrap">
    <a class="brand" href="/" aria-label="Murtaza Insights home">
      <img src="/images/murtaza-insights-full-logo-canonical.png" alt="Murtaza Insights" width="2048" height="768" />
      <small>Business · Management · Systems</small>
    </a>
    <button class="menu" aria-expanded="false" aria-controls="nav">Menu</button>
    <nav id="nav" aria-label="Main navigation">
      {links.map(([label, href]) => <a class={path === href || path === `${href}/` ? 'active' : ''} href={href}>{label}</a>)}
      <a class:list={["nav-search", { active: path.startsWith("/search") }]} href="/search" aria-label="Search" aria-expanded="false" aria-controls="site-search-panel"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" /><path d="m16 16 5 5" /></svg><span class="search-nav-label">Search</span></a>
    </nav>
  </div>
  <section id="site-search-panel" class="inline-search-panel" aria-label="Website search" hidden>
    <div class="inline-search-heading"><h2>Search</h2><button type="button" data-close-search aria-label="Close search">Close</button></div>
    <SiteSearch inputId="inline-search-query" />
    <a class="search-fallback" href="/search/">Open full search page</a>
  </section>
</header>
<script>
  const header = document.querySelector<HTMLElement>('.site-header');
  const updateHeaderHeight = () => {
    if (header) document.documentElement.style.setProperty('--site-header-height', `${header.getBoundingClientRect().height}px`);
  };
  if (header) new ResizeObserver(updateHeaderHeight).observe(header);
  updateHeaderHeight();
  const button = document.querySelector('.menu');
  const nav = document.querySelector('#nav');
  button?.addEventListener('click', () => {
    const open = button.getAttribute('aria-expanded') === 'true';
    button.setAttribute('aria-expanded', String(!open));
    nav?.classList.toggle('open');
  });
  const searchLink = document.querySelector<HTMLAnchorElement>('.nav-search');
  const panel = document.querySelector<HTMLElement>('#site-search-panel');
  let searchScrollY = 0;
  const closeSearch = () => { if (panel) panel.hidden = true; searchLink?.setAttribute('aria-expanded', 'false'); searchLink?.focus({ preventScroll: true }); window.scrollTo({ top: searchScrollY, behavior: 'instant' }); };
  searchLink?.addEventListener('click', event => {
    if (!panel) return;
    event.preventDefault();
    const open = !panel.hidden;
    if (open) { closeSearch(); return; }
    searchScrollY = window.scrollY;
    panel.hidden = false;
    searchLink.setAttribute('aria-expanded', String(!open));
    if (!open) panel.querySelector<HTMLInputElement>('input')?.focus({ preventScroll: true });
  });
  panel?.querySelector('[data-close-search]')?.addEventListener('click', closeSearch);
  document.addEventListener('keydown', event => { if (event.key === 'Escape' && panel && !panel.hidden) closeSearch(); });
  nav?.querySelectorAll('a').forEach(link => link.addEventListener('click', () => {
    button?.setAttribute('aria-expanded', 'false');
    nav.classList.remove('open');
  }));
</script>


<style>
.nav-search { display: inline-flex; align-items: center; gap: .5rem; }
.search-nav-label { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
@media (max-width: 900px) { .search-nav-label { position: static; width: auto; height: auto; clip-path: none; } }
</style>
