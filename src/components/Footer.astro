<script>
  document.querySelectorAll('[data-footer-captions]').forEach(container => {
    const captions = Array.from(container.querySelectorAll('.footer-caption'));
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    let current = 0;
    let paused = false;
    container.addEventListener('mouseenter', () => { paused = true; });
    container.addEventListener('mouseleave', () => { paused = false; });
    window.setInterval(() => {
      if (paused || reduced.matches || document.hidden) return;
      captions[current]?.classList.remove('is-current');
      current = (current + 1) % captions.length;
      captions[current]?.classList.add('is-current');
    }, 15000);
  });
</script>
