---
const { inputId = "search-query", page = false } = Astro.props;
---
  <div data-site-search data-search-page={page}><form class="search-form" action="/search" role="search">
   <label class="sr-only" for={inputId}>Search the website</label>
   <input id={inputId} name="q" type="search" placeholder="Search articles and memes" required />
   <button class="button" type="submit">Search</button>
  </form>
  <p data-search-status role="status">Enter a word or phrase to search the website.</p>
  <ul class="search-results" data-search-results></ul></div>

 <script>
  let searchIndex: Promise<{url:string;title:string;text:string}[]> | undefined;
  document.querySelectorAll<HTMLElement>('[data-site-search]').forEach(root => {
  const form = root.querySelector('form');
  const input = root.querySelector<HTMLInputElement>('input');
  const status = root.querySelector('[data-search-status]');
  const list = root.querySelector('[data-search-results]');

  async function search(query:string) {
   if (!list || !status) return;
   list.replaceChildren();
   const normalized = query.trim().toLocaleLowerCase();
   if (!normalized) { status.textContent = 'Enter a word or phrase to search the website.'; return; }
   status.textContent = 'Searching…';
   try {
    searchIndex ??= fetch('/search-index.json').then(response => { if (!response.ok) throw new Error('Index unavailable'); return response.json(); });
    const entries = await searchIndex;
    const escaped = normalized.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
    const matcher = new RegExp(`(^|[^\\p{L}\\p{N}])${escaped}($|[^\\p{L}\\p{N}])`, 'iu');
    const matches = entries.filter(entry => matcher.test(`${entry.title} ${entry.text}`))
      .sort((a,b) => Number(b.title.toLocaleLowerCase().includes(normalized)) - Number(a.title.toLocaleLowerCase().includes(normalized)));
    status.textContent = `${matches.length} result${matches.length === 1 ? '' : 's'} for “${query.trim()}”.`;
    for (const entry of matches) {
      const li = document.createElement('li'); const h2 = document.createElement('h2'); const link = document.createElement('a');
      link.href = entry.url; link.textContent = entry.title; h2.append(link);
      const excerpt = document.createElement('p'); const at = entry.text.toLocaleLowerCase().indexOf(normalized); const start = Math.max(0, at - 65);
      excerpt.textContent = `${start ? '…' : ''}${entry.text.slice(start,start+230)}${entry.text.length > start+230 ? '…' : ''}`;
      li.append(h2,excerpt);list.append(li);
    }
   } catch { searchIndex = undefined; status.textContent = 'Search is temporarily unavailable. Please try again.'; }
  }
  form?.addEventListener('submit',event => {event.preventDefault(); if (!input) return; if (root.dataset.searchPage === 'true') history.replaceState(null,'',`/search?q=${encodeURIComponent(input.value)}`); void search(input.value);});
  const query = new URLSearchParams(location.search).get('q');
  if (root.dataset.searchPage === 'true' && query && input) {input.value=query;void search(query);}
  });
 </script>
