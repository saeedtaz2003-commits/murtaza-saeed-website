---
import EngagementIcon from './EngagementIcon.astro';
import { commentsFormFor } from '../data/comments';

const { title, url, commentTitle = title, showComment = true, articleUrl, articleLabel = 'Read the Article', articleNewTab = false, trackDirectShare = false, class: className = '' } = Astro.props;
const absoluteUrl = new URL(url, Astro.site).toString();
// Tag outbound share destinations, leaving the canonical page URL unchanged.
const campaign = new URL(absoluteUrl).hash.replace(/^#/, '') || new URL(absoluteUrl).pathname.split('/').filter(Boolean).pop() || 'home';
const sharedUrl = (source) => {
  const tagged = new URL(absoluteUrl);
  tagged.searchParams.set('utm_source', source);
  tagged.searchParams.set('utm_medium', source === 'email' ? 'email' : source === 'whatsapp' ? 'messaging' : ['native_share', 'copy_link'].includes(source) ? 'share' : 'social');
  tagged.searchParams.set('utm_campaign', campaign);
  tagged.searchParams.set('utm_content', articleUrl || absoluteUrl.includes('/the-lighter-side') ? 'meme_share' : 'article_share');
  return tagged.toString();
};
const encodedTitle = encodeURIComponent(title);
---
<div class:list={['content-engagement', className]} data-content-share data-share-title={title} data-share-url={absoluteUrl} data-native-share-url={trackDirectShare ? sharedUrl('native_share') : undefined} data-copy-share-url={trackDirectShare ? sharedUrl('copy_link') : undefined}>
  <div class="engagement-legal-row">
    <p class="engagement-copyright-year">© 2026 <em>Murtaza Insights</em></p>
    <p class="engagement-policy"><a href="/copyright-sharing">Copyright &amp; Sharing Policy</a></p>
  </div>
  <div class="engagement-share-row" aria-label="Share this content">
    {articleUrl && <a class="engagement-article" href={articleUrl} target={articleNewTab ? '_blank' : undefined} rel={articleNewTab ? 'noopener noreferrer' : undefined}><EngagementIcon name="link" />{articleLabel}</a>}
    {showComment && <a class="engagement-comment" href={commentsFormFor(commentTitle)} target="_blank" rel="noopener noreferrer"><EngagementIcon name="message" />Send a Comment</a>}
    <button type="button" data-share-trigger><EngagementIcon name="share" />Share</button>
    <button type="button" data-copy-link><EngagementIcon name="link" /><span data-copy-label>Copy Link</span></button>
    <span data-share-status aria-live="polite"></span>
  </div>
  <div class="engagement-share-menu" data-share-fallback hidden aria-label="Share options">
    <a href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(sharedUrl('facebook'))}`} target="_blank" rel="noopener noreferrer">Facebook</a>
    <a href={`https://wa.me/?text=${encodeURIComponent(sharedUrl('whatsapp'))}`} target="_blank" rel="noopener noreferrer">WhatsApp</a>
    <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(sharedUrl('linkedin'))}`} target="_blank" rel="noopener noreferrer">LinkedIn</a>
    <a href={`https://twitter.com/intent/tweet?text=${encodedTitle}&url=${encodeURIComponent(sharedUrl('x'))}`} target="_blank" rel="noopener noreferrer">X</a>
    <a href={`mailto:?subject=${encodedTitle}&body=${encodedTitle}%0A${encodeURIComponent(sharedUrl('email'))}`}>Email</a>
  </div>
</div>
