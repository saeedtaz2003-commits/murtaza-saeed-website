---
import { getCollection } from 'astro:content';
import ArticleCard from './ArticleCard.astro';
const { currentSlug, category } = Astro.props;
// Category-specific recommendations must only include articles in the same canonical category.
const posts = (await getCollection('posts'))
  .filter(p => !p.data.draft && !p.data.advertorial && p.data.slug !== currentSlug && p.data.category === category)
  .sort((a,b) => +b.data.date - +a.data.date)
  .slice(0,3);

---
{posts.length > 0 && <section class="related-articles" aria-labelledby="related-title"><h2 id="related-title">More from {category}</h2><div class="related-grid">{posts.map(p => <ArticleCard post={p} compact />)}</div></section>}
