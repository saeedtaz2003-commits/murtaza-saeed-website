---
import ExternalCtaIcon from './ExternalCtaIcon.astro';
interface Props { topic: 'Updates' | 'Biz Buzz'; }
const { topic } = Astro.props;
const number = '254726829626';
const message = topic === 'Updates' ? 'Please add me to general Murtaza Insights updates.' : 'Please add me to Biz Buzz alerts.';
const label = topic === 'Updates' ? 'Get Updates' : 'Get New Meme Notifications';
const href = `https://wa.me/${number}?text=${encodeURIComponent(message)}`;
---
<aside class:list={["whatsapp-alerts", { "article-updates": topic === 'Updates' }]}>
  <h2>{topic === 'Updates' ? 'Be the First to Get New Updates' : 'Like Biz Buzz?'}</h2>
  <a class="button" href={href} target="_blank" rel="noopener noreferrer"><ExternalCtaIcon network="whatsapp" />{label}</a>
  {topic === 'Biz Buzz' && <p><a class="button" href="/the-lighter-side#funny-slider">Explore More Memes</a></p>}
  <p>Send the message, then save <em>Murtaza Insights</em> (+254 726 829626) in your contacts to receive broadcast alerts.</p>
</aside>

