---
import Base from '../layouts/Base.astro';
const capabilities = [
  { id: 'financial-analysis', title: 'Financial Analysis & Management Reporting', text: 'My work has focused on turning accounting and operational data into information that managers can use. At Pwani Oil Products, I developed management-information and exception-reporting systems for the Board, executive management and departmental heads. At Comcraft Services, I designed management reports and improved the flow of information supporting management accounts, quarterly Board reporting, year-end closing and external audit.' },
  { id: 'business-reviews', title: 'Business Reviews & Performance Improvement', text: 'I look at financial performance in the context of how a business operates. At Pwani, I introduced Value Addition per Kg (VA/KG) to make profitability easier to understand and the Bulk-to-Consumer Ratio (BC Ratio) to track product mix, market penetration and brand development. My experience includes reviewing controls, processes and management information across functions.' },
  { id: 'planning', title: 'Budgeting, Forecasting & Planning', text: 'I introduced formal budgeting and budgetary control at E.A. Match, together with Management by Objectives and Zero-Based Budgeting concepts. At Pwani, I supported structured budgeting, cash-flow forecasting and capital-expenditure planning, and initiated strategic planning with external consultants.' },
  { id: 'projects', title: 'Project Support & Business Expansion', text: 'At Pwani, I prepared feasibility studies for two major expansion projects, supporting successful syndicated bank financing and related VAT-exemption applications. Earlier, at E.A. Match, I managed operational and expansion initiatives including a vertical-supply project approximately 800 km from the main operation, a new manufacturing facility and the development of a trading and distribution business.' },
  { id: 'systems', title: 'ERP, Accounting Systems & Process Improvement', text: 'My systems experience spans early mechanised and computerised accounting through to integrated ERP. I led Pastel implementation at Pwani and developed customised applications with programming support. As Director – Value Chain Development, I led pre-ERP planning, evaluation, partner assessment, super-user development and change-management preparation, then worked closely with Oracle specialists during the Oracle E-Business Suite 12 rollout. At Comcraft, I took over and successfully implemented a stalled IMPACT ENCORE project across five Aluminium Group companies.' },
  { id: 'operations', title: 'Operations & General Management', text: 'At E.A. Match, I progressed from Accountant to Chief Accountant, Operations Manager and General Manager. For more than five years I managed three manufacturing units, the trading operation and the workshop profit centre. This experience connected finance with production, purchasing, operational decisions and business development.' },
  { id: 'commercial', title: 'Strategic & Commercial Perspective', text: 'My responsibilities have extended beyond finance into governance, strategic planning and cross-functional management. I helped commercialise E.A. Match’s in-house workshop as a profit centre serving external customers and supported development-bank funding for expansion and specialised manufacturing equipment. At Pwani, my contributions also included customer presentations, packaging and label redesign, advertising campaigns and a self-administered company medical scheme.' },
  { id: 'digital', title: 'Digital Business & Promotion', text: 'Through Next Step Consulting, from 2012 to 2021, I developed practical experience in promotional material, presentations, social-media campaigns, targeted Facebook advertising, websites, SEO and Google business listings. Assignments included Nyali Centre and Shanker Electronics. Voluntary work for Nyali Golf & Country Club included the “Have Your Say” project, gathering and presenting members’ priorities for the club’s development. Next Step Consulting is a past chapter of my career.' }
];
const timeline = [
  ['2026–Present', 'Remote Finance & Business Advisor'],
  ['2012–2021', 'Lead Consultant – Digital Marketing & Business Promotion, Next Step Consulting'],
  ['2011–2012', 'Director – Value Chain Development, Pwani Oil Products Ltd'],
  ['2004–2011', 'Chief Finance Manager, Pwani Oil Products Ltd'],
  ['1995–2002', 'MIS Manager, Comcraft Services Ltd'],
  ['1977–1994', 'Accountant → Chief Accountant → Operations Manager → General Manager, E.A. Match Co. (K) Ltd']
];
const jsonLd = { '@context': 'https://schema.org', '@type': 'Person', name: 'Murtaza Saeed', jobTitle: 'Remote Finance & Business Advisor', url: new URL('/in-depth-profile', Astro.site).href, sameAs: ['https://linkedin.com/in/murtaza-saeed'], description: 'Finance and business professional with more than 35 years of experience in financial management, business systems, operations and general management.' };
---
<Base title="In-Depth Profile of Murtaza Saeed | Remote Finance & Business Advisor" description="Explore Murtaza Saeed’s career, capabilities and major projects across financial analysis, business reviews, ERP, manufacturing and general management." jsonLd={jsonLd}>
  <section class="page-head wrap"><p class="eyebrow">Professional background</p><h1>In-Depth Profile of Murtaza Saeed</h1><h2>Remote Finance &amp; Business Advisor</h2><p>Financial Analysis • Business Reviews • Project Support</p></section>
  <section class="section wrap profile-layout">
    <nav class="profile-nav" aria-label="In this profile"><strong>In this profile</strong>{capabilities.map(item => <a href={`#${item.id}`}>{item.title}</a>)}<a href="#current-focus">Current Focus</a><a href="#professional-background">Professional Background</a><a href="#career-timeline">Career Timeline</a><a href="#work-with-me">Work With Me</a></nav>
    <div class="prose">
      <p>My career has combined financial management with a practical understanding of systems, manufacturing, operations and business development. With more than 35 years of experience, I bring a broad perspective to the numbers and the decisions behind them.</p>
      {capabilities.map(item => <section id={item.id} class="profile-capability"><h2>{item.title}</h2><p>{item.text}</p></section>)}
      <section id="current-focus" class="profile-routes"><h2>Current Focus</h2><p>I provide selective remote finance and business support to organisations that need experienced input without a full-time senior finance appointment.</p><p>Based in Kenya, I am available for remote assignments with businesses in Kenya, the UK and other international markets. My focus is on work that can be delivered effectively remotely, with on-site involvement considered only where genuinely necessary and practical.</p><p>I also publish business, finance and technology commentary at <em>Murtaza Insights</em>.</p></section>
      <section id="professional-background"><h2>Professional Background</h2><p>I qualified as a Chartered Accountant with ICAEW earlier in my career. My subsequent experience has extended across financial management, management reporting, business systems, operations and general management.</p><p>I have the legal right to work in both Kenya and the United Kingdom.</p></section>
      <section id="career-timeline"><h2>Career Timeline</h2><ol class="career-timeline">{timeline.map(([dates, role]) => <li><strong>{dates}</strong><span>{role}</span></li>)}</ol></section>
      <section id="work-with-me" class="cta"><h2>Work With Me</h2><p>For financial analysis, a business review or project support, share your objective, expected timescale and the help you need.</p><div class="actions"><a class="button" href="/work-with-me">Explore how I can help</a><a class="read" href="https://linkedin.com/in/murtaza-saeed" target="_blank" rel="noopener noreferrer">View LinkedIn Profile ↗</a></div></section>
    </div>
  </section>
</Base>
