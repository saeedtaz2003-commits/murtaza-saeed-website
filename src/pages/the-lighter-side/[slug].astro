---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import BrandText from '../../components/BrandText.astro';
import { italicizeBrandHtml } from '../../utils/brand-format.mjs';
import { funnyBizzItems, funnyBizzShareUrl, funnyBizzViewerUrl } from '../../data/funny-bizz';
import ContentEngagement from '../../components/ContentEngagement.astro';

export function getStaticPaths() {
  return funnyBizzItems.map((item) => ({
    params: { slug: item.id },
    props: { item }
  }));
}

const { item } = Astro.props;
const isPapss = item.id === 'papss-kenya-nigeria-shortcut';
const viewerUrl = funnyBizzViewerUrl(item.id);
const linkedArticle = item.id === 'quickmart-ipo-ksh7-50-is-it-worth-buying'
  ? (await getCollection('posts')).find(post => post.data.slug === item.id)
  : undefined;
const previewCopy = linkedArticle?.data.metaDescription ?? item.copy;
const description = previewCopy.length > 190 ? `${previewCopy.slice(0, 187)}…` : previewCopy;
const pageTitle = `${item.title} | Biz Buzz | Murtaza Insights`;

// Social platforms are more reliable with a lightweight, explicitly-sized image.
// Keep each permalink item-specific so WhatsApp/Facebook can fetch the correct preview.
const isCurrentQuickmart = item.id === 'quickmart-ipo-ksh7-50-is-it-worth-buying';
const useOriginalSocialImage = isCurrentQuickmart || item.id === 'papss-kenya-nigeria-shortcut';
const socialSize = useOriginalSocialImage ? 1254 : item.id === 'simbisa-customers-spend-less' ? 1080 : 1200;
const socialImage = useOriginalSocialImage ? item.image : `/images/social/${item.id}.jpg`;
---
<Base
  noindex={item.hidden}
  title={pageTitle}
  description={description}
  image={socialImage}
  imageAlt={item.alt}
  imageWidth={socialSize}
  imageHeight={socialSize}
  type="website"
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'CreativeWork',
    '@id': new URL(Astro.url.pathname, Astro.site).toString(),
    url: new URL(Astro.url.pathname, Astro.site).toString(),
    name: item.title,
    description,
    image: new URL(item.image, Astro.site).toString(),
    author: { '@type': 'Person', '@id': new URL('/about/#person', Astro.site).toString(), name: 'Murtaza Saeed', url: new URL('/about/', Astro.site).toString() }
  }}
>
  <section class="section wrap funny-share-landing">
    <p class="eyebrow">Biz Buzz</p>
    <h1>{isPapss ? item.commentaryTitle ?? item.title : item.title}</h1>
    <img src={item.image} alt={item.alt} />
    {isPapss ? (
      <div class="papss-permalink-copy">
        {(item.commentaryCopyHtml ?? item.copy).split(/\n\n/).map(paragraph => <p set:html={italicizeBrandHtml(paragraph)} />)}
      </div>
    ) : <p><BrandText text={item.copy} /></p>}
    {!isPapss && item.destinationUrl && <p><a class="button" href={item.destinationUrl}>{item.ctaLabel ?? 'Read the Article'}</a></p>}
    <p><a class="button" href={viewerUrl}>Open in Biz Buzz Slideshow</a></p>
    <ContentEngagement title={item.title} commentTitle={item.title} url={funnyBizzShareUrl(item.id)} />
  </section>
  <script define:vars={{ viewerUrl }}>
    // Keep canonical pages crawlable. Preview crawlers do not receive fragments;
    // visitors following an explicitly shared link enter the selected slideshow.
    if (window.location.hash === '#view=slider') {
      window.location.replace(viewerUrl);
    }
  </script>
</Base>

