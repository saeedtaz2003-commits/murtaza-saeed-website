---
import Base from '../../layouts/Base.astro';
import { funnyBizzItems } from '../../data/funny-bizz';
import ContentEngagement from '../../components/ContentEngagement.astro';

export function getStaticPaths() {
  return funnyBizzItems.map((item) => ({
    params: { slug: item.id },
    props: { item }
  }));
}

const { item } = Astro.props;
const viewerUrl = `/the-lighter-side?meme=${encodeURIComponent(item.id)}#funny-slider`;
const description = item.copy.length > 190 ? `${item.copy.slice(0, 187)}…` : item.copy;
const pageTitle = `${item.title} | BIZ BUZZ | Murtaza Insights`;

// Social platforms are more reliable with a lightweight, explicitly-sized image.
// Keep each permalink item-specific so WhatsApp/Facebook can fetch the correct preview.
const socialImage = `/images/social/${item.id}.jpg`;
---
<Base
  title={pageTitle}
  description={description}
  image={socialImage}
  imageAlt={item.alt}
  imageWidth={1200}
  imageHeight={1200}
  type="article"
>
  <section class="section wrap funny-share-landing">
    <p class="eyebrow">BIZ BUZZ</p>
    <h1>{item.title}</h1>
    <img src={item.image} alt={item.alt} />
    <p>{item.copy}</p>
    <p><a class="button" href={viewerUrl}>Open in BIZ BUZZ slideshow</a></p>
    <ContentEngagement title={item.title} commentTitle={item.title} url={`/the-lighter-side/${item.id}?v=3`} />
  </section>
  <script define:vars={{ viewerUrl }}>
    window.location.replace(viewerUrl);
  </script>
</Base>

