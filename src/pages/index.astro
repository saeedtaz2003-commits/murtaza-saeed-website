---
import { getCollection } from 'astro:content';
import ArticleCard from '../components/ArticleCard.astro';
const recent = (await getCollection('posts', ({data}) => !data.draft && !data.advertorial)).sort((a,b) => +b.data.date - +a.data.date).slice(0,3);
import Base from '../layouts/Base.astro';
---
<Base title="Murtaza Saeed | Remote Business Advisor" description="Remote business advisor for owner-managed mid-sized businesses in Kenya and East Africa. Performance reviews, business analysis and systems improvement.">
<section class="hero"><div class="wrap"><p class="kicker">Murtaza Saeed</p><h1>Remote Business Advisor</h1>
<p class="lead">I work with owners, managing directors and CEOs of mid-sized manufacturing, processing, FMCG, distribution and trading businesses, especially owner-managed and family firms. My focus is Kenya and East Africa, with selected remote assignments in the UK and elsewhere internationally.</p>
<p>I have more than 35 years of experience in finance, manufacturing operations and business systems. At Pwani Oil Products, I developed management reports for the Board and department heads. At E.A. Match, I managed three manufacturing units.</p></div></section>
<section class="section muted"><div class="wrap"><h2>How I can help</h2><div class="topics home-topics">
<a href="/work-with-me/"><h3>Business Performance Reviews</h3><p>Find out which products, customers or costs are putting pressure on margins, even as sales grow.</p></a>
<a href="/work-with-me/"><h3>Business Analysis &amp; Strategy</h3><p>Test the assumptions behind an expansion or pricing decision before committing resources.</p></a>
<a href="/work-with-me/"><h3>Information Systems &amp; Process Improvement</h3><p>Trace why stock figures differ across departments or why month-end reporting depends on manual reconciliations.</p></a>
</div><div class="actions"><a class="button" href="https://forms.gle/AWvix79y4bZUg7rQ6" target="_blank" rel="noopener noreferrer">Discuss an Assignment</a></div></div></section>
<section class="section wrap listing archive-list"><h2>Latest Insights</h2><p>I publish independent business analysis on <em>Murtaza Insights</em>. These articles give you a sense of how I approach business problems and weigh the options.</p>{recent.map(post => <ArticleCard post={post} compact trailingSlash />)}<p class="view-all-insights"><a class="read" href="/insights/">View all Insights</a></p></section>
<section class="section wrap about-strip"><h2>About Murtaza</h2><p>Read about my work in manufacturing operations, management reporting and business systems.</p><p class="home-follow-up"><a href="/in-depth-profile/">Read my full profile</a></p></section>
<section class="section wrap about-strip"><h2>Pro Bono Business Advisory</h2><p>I offer pro bono business advice to selected micro and small businesses already operating in Kenya.</p><p class="home-follow-up"><a href="/pro-bono/">Learn about pro bono assistance</a></p></section>
<section class="section wrap about-strip"><h2>Biz Buzz</h2><p>Short observations on business, technology and the occasional round of golf.</p><p class="home-follow-up"><a href="/the-lighter-side/">Browse Biz Buzz</a></p></section>
<div class="section wrap actions"><a class="button" href="https://forms.gle/AWvix79y4bZUg7rQ6" target="_blank" rel="noopener noreferrer">Discuss an Assignment</a></div>
</Base>

<style>
  .view-all-insights { text-align: center; margin-block: .75rem; }
  .about-strip > p:not(.home-follow-up) { margin-bottom: 0; }
  .home-follow-up { margin-top: .35rem; }
</style>
