---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ArticleCard from '../components/ArticleCard.astro';
const posts = (await getCollection('posts')).filter(p => !p.data.draft && !p.data.advertorial).sort((a,b) => +b.data.date - +a.data.date);
---
<Base title="Murtaza Saeed | Remote Business Advisor" description="Murtaza Saeed is a Remote Business Advisor working on business performance reviews, business analysis and strategy, and information systems and process improvement.">
<section class="hero"><div class="wrap hero-grid"><div><p class="kicker">Murtaza Saeed</p><h1>Remote Business Advisor</h1><p class="advisor-service-line">Business Performance Reviews • Business Analysis &amp; Strategy • Information Systems &amp; Process Improvement</p><p class="lead">Experienced, independent perspective on business performance, important decisions, systems and practical improvement.</p><div class="actions"><a class="button" href="/work-with-me">Work With Me</a><a class="text-link" href="/insights">Explore Insights</a><a class="text-link" href="/about">About Me</a></div></div><aside class="hero-note"><p>“A good decision starts with asking the right question—and looking beyond the obvious answer.”</p><span>— Murtaza Saeed</span></aside></div></section>
<section class="section muted"><div class="wrap"><p class="eyebrow">How I can help</p><h2>Three areas of focus</h2><div class="topics home-topics"><a href="/work-with-me"><span>01</span><h3>Business Performance Reviews</h3><p>Independent review of performance, operations, management information and the issues requiring management attention.</p></a><a href="/work-with-me"><span>02</span><h3>Business Analysis &amp; Strategy</h3><p>Structured analysis of opportunities, alternatives, assumptions and risks to support better-informed decisions.</p></a><a href="/work-with-me"><span>03</span><h3>Information Systems &amp; Process Improvement</h3><p>Practical review of systems, information flows and processes, including appropriate use of ERP, AI and other technology.</p></a></div><p class="home-biz-buzz">…and for the unusual, surprising and occasionally amusing, there’s <a href="/the-lighter-side">Biz Buzz →</a>.</p></div></section>
<section id="latest" class="section wrap"><div class="section-heading"><div><p class="eyebrow">Latest insight</p><h2>Business thinking from a practitioner’s perspective</h2></div></div>{posts[0] && <ArticleCard post={posts[0]} featured />}<div class="home-view-all"><a class="button" href="/insights">View Insights</a></div></section>
<section class="section wrap about-strip"><div><p class="eyebrow">About Murtaza</p><h2>More than 35 years across finance, operations, systems and general management</h2></div><div><p>Murtaza Insights is my independent publishing home for practical commentary on business decisions, management issues, systems and technology.</p><div class="actions"><a class="read" href="/about">About Murtaza →</a><a class="read" href="/work-with-me">Work With Me →</a></div></div></section>
</Base>
