---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ArticleCard from '../components/ArticleCard.astro';
const posts = (await getCollection('posts'))
  .filter(p => !p.data.draft && !p.data.advertorial)
  .sort((a,b) => +b.data.date - +a.data.date);
---
<Base title="Murtaza Saeed | Finance & Business Insights">
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <p class="kicker">Finance · Business · Technology · Leadership</p>
        <h1>Experience, examined.<br /><span>Ideas, clearly shared.</span></h1>
        <p class="lead">Independent financial and operational insight for business owners, executives, boards and investors navigating growth, governance and change.</p>
        <div class="actions"><a class="button" href="#latest">Read the latest</a><a class="text-link" href="/work-with-me">Work with me →</a></div>
      </div>
      <aside class="hero-note"><p>“A good decision starts with asking the right question—and looking beyond the obvious answer.”</p><span>— Murtaza Saeed</span></aside>
    </div>
  </section>
  <section id="latest" class="section wrap">
    <div class="section-heading"><div><p class="eyebrow">Latest perspective</p><h2>Fresh thinking, without the noise</h2></div></div>
    {posts[0] && <ArticleCard post={posts[0]} featured />}
    <div class="home-view-all"><a class="button" href="/articles">View All Articles</a></div>
  </section>
  <section class="section muted"><div class="wrap"><p class="eyebrow">Explore by subject</p><h2>What you’ll find here</h2><div class="topics home-topics">
    <a href="/business-finance"><span>01</span><h3>Business & Finance</h3><p>Markets, companies and the decisions behind the numbers.</p></a>
    <a href="/technology"><span>02</span><h3>Technology</h3><p>Useful technology, responsible AI and their implications for business and society.</p></a>
    <a href="/advertorials"><span>03</span><h3>Advertorials</h3><p>Clearly identified sponsored content for businesses and organisations with a useful story to tell.</p></a>
    <a href="/the-lighter-side"><span>04</span><h3>The Lighter Side</h3><p>Humour and observations from business, technology and life beyond the boardroom.</p></a>
  </div></div></section>
  <section class="section wrap about-strip"><div><p class="eyebrow">About Murtaza</p><h2>A long view, with curiosity intact.</h2></div><div><p>I’m a retired Chartered Accountant and former finance executive based in Mombasa, Kenya. <em>Murtaza Insights</em> is written for owners, senior executives, board members and investors seeking a practical, independent perspective on financial performance, operations, governance and digital transformation.</p><a class="read" href="/about">More about me →</a></div></section>
</Base>
