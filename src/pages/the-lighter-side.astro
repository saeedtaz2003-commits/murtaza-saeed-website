---
import Base from '../layouts/Base.astro';
import ContentSlider from '../components/ContentSlider.astro';
---
<Base title="BIZ BUZZ | Murtaza Insights" description="The unusual, surprising and occasionally amusing side of business.">
  <section class="page-head wrap lighter-head">
    <p class="eyebrow">BIZ BUZZ</p>
    <h1>BIZ BUZZ</h1>
    <p class="lighter-subtitle">The unusual, surprising and occasionally amusing side of business.</p>
    <p>Serious decisions do not always require a serious expression. Here are a few cartoons and observations about markets, technology, executive life and the endlessly humbling game of golf.</p>
    <p><strong>Swipe or use Previous/Next to browse. Read the commentary below each selected item ↓</strong></p>
    <div class="bunting" aria-hidden="true">
      {Array.from({ length: 13 }).map(() => <i></i>)}
    </div>
  </section>

  <ContentSlider />
</Base>

