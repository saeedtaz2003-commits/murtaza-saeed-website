---
import Base from '../layouts/Base.astro';
import ContentSlider from '../components/ContentSlider.astro';
---
<Base title="Biz Buzz | Murtaza Insights" description="The unusual, surprising and occasionally amusing side of business &amp; life.">
  <section class="page-head wrap lighter-head">
    <p class="eyebrow">Biz Buzz</p>
    <h1>Biz Buzz</h1>
    <p class="lighter-subtitle">The unusual, surprising and occasionally amusing side of business &amp; life.</p>
    <p>Serious decisions do not always require a serious expression. Here are a few cartoons and observations about markets, technology, executive life and the endlessly humbling game of golf.</p>
    <p><strong>Swipe or use the arrows to browse. See the commentary for the story behind each item.</strong></p>
    <div class="bunting" aria-hidden="true">
      {Array.from({ length: 13 }).map(() => <i></i>)}
    </div>
  </section>

  <ContentSlider />
</Base>

