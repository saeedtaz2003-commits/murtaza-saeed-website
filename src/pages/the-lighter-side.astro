---
import Base from '../layouts/Base.astro';
import ContentSlider from '../components/ContentSlider.astro';
---
<Base title="Funny Bizz | Murtaza Insights" description="Executive-friendly humour and observations from business, technology, golf and life beyond the boardroom.">
  <section class="page-head wrap lighter-head">
    <p class="eyebrow">The Lighter Side</p>
    <h1>Funny Bizz</h1>
    <p class="lighter-subtitle">The lighter side of business—and life</p>
    <p>Serious decisions do not always require a serious expression. Here are a few cartoons and observations about markets, technology, executive life and the endlessly humbling game of golf.</p>
    <div class="bunting" aria-hidden="true">
      {Array.from({ length: 13 }).map(() => <i></i>)}
    </div>
  </section>

  <ContentSlider />
</Base>
