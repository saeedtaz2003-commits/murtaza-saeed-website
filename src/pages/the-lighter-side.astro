---
import Base from '../layouts/Base.astro';
import { funnyBizzItems as items, funnyBizzPermalink } from '../data/funny-bizz';
---
<Base title="Funny Bizz | Murtaza Insights" description="Executive-friendly humour and observations from business, technology, golf and life beyond the boardroom.">
  <section class="page-head wrap lighter-head">
    <p class="eyebrow">The Lighter Side</p>
    <h1>Funny Bizz</h1>
    <p class="lighter-subtitle">The lighter side of business—and life</p>
    <p>Serious decisions do not always require a serious expression. Here are a few cartoons and observations about markets, technology, executive life and the endlessly humbling game of golf.</p>
    <div class="bunting" aria-hidden="true">
      {Array.from({ length: 13 }).map(() => <i></i>)}
    </div>
  </section>

  <section id="funny-slider" class="section wrap funny-carousel-section" aria-label="Funny Bizz slideshow">
    <div class="funny-carousel" data-carousel>
      <p class="funny-slider-note">
        <strong>Funny Bizz Slideshow</strong> — tap or swipe the meme, or use Previous/Next to browse.
        <span class="funny-viewer-status" data-viewer-status>Loading slideshow…</span>
      </p>

      <div class="funny-viewer-grid">
        <div class="funny-viewer-media">
          <div class="funny-screen-frame" aria-live="polite">
            <div class="funny-slides">
              {items.map((item, index) => (
                item.destinationUrl ? (
                  <a
                    class:list={['funny-slide-image', index === 0 && 'active']}
                    href={item.destinationUrl}
                    data-slide
                    data-destination-link
                    data-item-id={item.id}
                    data-slider-category={item.sliderCategory}
                    data-permalink={funnyBizzPermalink(item.id)}
                    data-share-title={item.title}
                    aria-hidden={index === 0 ? 'false' : 'true'}
                    aria-label={`${item.sliderCategory}: ${item.title}. Open destination.`}
                  >
                    <span class="meme-stage" style={`--meme-image: url('${item.image}')`}>
                      <img src={item.image} alt={item.alt} loading={index < 2 ? 'eager' : 'lazy'} />
                    </span>
                  </a>
                ) : (
                  <button
                    class:list={['funny-slide-image', index === 0 && 'active']}
                    type="button"
                    data-slide
                    data-next-image
                    data-item-id={item.id}
                    data-slider-category={item.sliderCategory}
                    data-permalink={funnyBizzPermalink(item.id)}
                    data-share-title={item.title}
                    aria-hidden={index === 0 ? 'false' : 'true'}
                    aria-label={`Show next slideshow item after ${item.title}`}
                  >
                    <span class="meme-stage" style={`--meme-image: url('${item.image}')`}>
                      <img src={item.image} alt={item.alt} loading={index < 2 ? 'eager' : 'lazy'} />
                    </span>
                  </button>
                )
              ))}
            </div>
          </div>

          <div class="funny-controls" aria-label="Slideshow controls">
            <button class="funny-control" type="button" data-prev aria-label="Previous slideshow item">← Previous</button>
            <div class="funny-dots" data-dots aria-label="Choose slideshow item"></div>
            <button class="funny-control" type="button" data-next aria-label="Next slideshow item">Next →</button>
          </div>

          <div class="funny-share-row" aria-label="Share this item">
            <button class="funny-share-button" type="button" data-share>Share</button>
            <button class="funny-share-button" type="button" data-copy-link>Copy link</button>
            <span class="funny-copy-status" data-copy-status aria-live="polite"></span>
          </div>

          <div class="funny-share-menu" data-share-menu hidden>
            <a data-share-facebook target="_blank" rel="noopener noreferrer">Facebook</a>
            <a data-share-whatsapp target="_blank" rel="noopener noreferrer">WhatsApp</a>
            <a data-share-linkedin target="_blank" rel="noopener noreferrer">LinkedIn</a>
            <a data-share-x target="_blank" rel="noopener noreferrer">X</a>
            <a data-share-email>Email</a>
          </div>
        </div>

        <div class="funny-commentary-viewport" aria-live="polite">
          {items.map((item, index) => (
            <article class:list={['funny-commentary-panel', index === 0 && 'active']} data-commentary-panel aria-hidden={index === 0 ? 'false' : 'true'}>
              <div class="lighter-copy">
                {item.sliderCategory !== 'Funny' && (
                  <p class:list={['funny-content-badge', item.sliderCategory === 'Advertorial' && 'is-advertorial']}>
                    {item.sliderCategory === 'Advertorial' ? 'Advertorial' : 'Featured Article'}
                  </p>
                )}
                <p class="eyebrow">{item.category}</p>
                {'advertiser' in item && item.advertiser && <p class="funny-advertiser">Sponsored by {item.advertiser}</p>}
                <h2 set:html={item.titleHtml ?? item.title} />
                <p set:html={item.copyHtml ?? item.copy} />
                {'domains' in item && item.domains && (
                  <section class="domain-name-list" aria-label="Unfortunate domain names">
                    <h3>Unfortunate Domain Names</h3>
                    <ul>
                      {item.domains.map(([domain, meaning]) => (
                        <li><strong>{domain}</strong> <span>({meaning})</span></li>
                      ))}
                    </ul>
                  </section>
                )}
                {'closing' in item && item.closing && <p>{item.closing}</p>}
                {item.destinationUrl && (
                  <p class="funny-content-link">
                    <a class="funny-content-cta" href={item.destinationUrl}>{item.ctaLabel ?? (item.sliderCategory === 'Advertorial' ? 'View advertorial →' : 'Read the full article →')}</a>
                  </p>
                )}
              </div>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="wrap funny-archive" aria-labelledby="funny-archive-title">
    <p class="eyebrow">Archive</p>
    <h2 id="funny-archive-title">All Funny Bizz</h2>
    <p class="funny-archive-instruction">Select any item to load it into the slideshow viewer above.</p>
    <div class="funny-archive-list">
      {items.map((item, index) => (
        <button
          class:list={['funny-archive-selector', index === 0 && 'active']}
          type="button"
          data-archive-index={index}
          data-item-id={item.id}
          aria-current={index === 0 ? 'true' : 'false'}
          aria-label={`Show ${item.title} in the Funny Bizz viewer`}
        >
          <img class="funny-archive-summary-thumb" src={item.image} alt="" loading="lazy" />
          <span class="funny-archive-summary-text">
            <span class="funny-archive-title" set:html={item.titleHtml ?? item.title} />
            <small>{item.sliderCategory === 'Funny' ? item.category : `${item.sliderCategory} · ${item.category}`}</small>
          </span>
          <span class="funny-archive-open" aria-hidden="true">↗</span>
        </button>
      ))}
    </div>
  </section>

  <script>
    const carousel = document.querySelector('[data-carousel]');
    if (carousel) {
      const slides = Array.from(carousel.querySelectorAll('[data-slide]'));
      const panels = Array.from(carousel.querySelectorAll('[data-commentary-panel]'));
      const archiveButtons = Array.from(document.querySelectorAll('[data-archive-index]'));
      const commentaryViewport = carousel.querySelector('.funny-commentary-viewport');
      const screen = carousel.querySelector('.funny-screen-frame');
      const dotsContainer = carousel.querySelector('[data-dots]');
      const status = carousel.querySelector('[data-viewer-status]');
      const shareButton = carousel.querySelector('[data-share]');
      const copyButton = carousel.querySelector('[data-copy-link]');
      const copyStatus = carousel.querySelector('[data-copy-status]');
      const shareMenu = carousel.querySelector('[data-share-menu]');
      let sequence = [];
      let dotButtons = [];
      let current = 0;
      let touchStartX = 0;
      let ignoreNextClick = false;

      const shuffle = (values) => {
        const result = [...values];
        for (let i = result.length - 1; i > 0; i -= 1) {
          const j = Math.floor(Math.random() * (i + 1));
          [result[i], result[j]] = [result[j], result[i]];
        }
        return result;
      };

      const indicesFor = (category) => slides
        .map((slide, index) => slide.getAttribute('data-slider-category') === category ? index : -1)
        .filter((index) => index >= 0);

      const buildSequence = () => {
        const funnyPool = shuffle(indicesFor('Funny'));
        const featuredPool = shuffle(indicesFor('Featured Article'));
        const advertorialPool = shuffle(indicesFor('Advertorial'));
        const maxSlides = Math.min(10, slides.length);
        if (!maxSlides) return [];

        // With a 10-item maximum, a single advertorial would occupy 10% of one sequence.
        // We therefore include one only on some loads so its long-run exposure remains about 5% or less.
        const advertorialChance = Math.min(0.5, maxSlides * 0.05);
        const advertorialCount = advertorialPool.length > 0 && featuredPool.length > 0 && Math.random() < advertorialChance ? 1 : 0;
        const baseFeaturedCount = featuredPool.length > 0 && maxSlides >= 5
          ? Math.max(1, Math.round(maxSlides * 0.18))
          : 0;
        const featuredCount = Math.min(featuredPool.length, Math.max(0, baseFeaturedCount - advertorialCount));
        const funnyCount = Math.min(funnyPool.length, Math.max(0, maxSlides - featuredCount - advertorialCount));

        const funnySelection = funnyPool.slice(0, funnyCount);
        const specials = shuffle([
          ...featuredPool.slice(0, featuredCount),
          ...advertorialPool.slice(0, advertorialCount)
        ]);

        // Insert special items into distinct gaps between Funny items so two specials never sit together.
        const availableGaps = shuffle(Array.from({ length: funnySelection.length + 1 }, (_, index) => index));
        const specialByGap = new Map();
        specials.slice(0, availableGaps.length).forEach((itemIndex, index) => {
          specialByGap.set(availableGaps[index], itemIndex);
        });

        const arranged = [];
        for (let gap = 0; gap <= funnySelection.length; gap += 1) {
          if (specialByGap.has(gap)) arranged.push(specialByGap.get(gap));
          if (gap < funnySelection.length) arranged.push(funnySelection[gap]);
        }
        return arranged;
      };

      const rebuildDots = () => {
        if (!(dotsContainer instanceof HTMLElement)) return;
        dotsContainer.innerHTML = '';
        dotButtons = sequence.map((itemIndex, position) => {
          const dot = document.createElement('button');
          dot.type = 'button';
          dot.className = 'funny-dot';
          const title = slides[itemIndex]?.getAttribute('data-share-title') ?? `item ${position + 1}`;
          dot.setAttribute('aria-label', `Show slideshow item ${position + 1}: ${title}`);
          dot.addEventListener('click', () => show(itemIndex));
          dotsContainer.appendChild(dot);
          return dot;
        });
      };

      const activeSlide = () => slides[current];

      const activeShareData = () => {
        const slide = activeSlide();
        const path = slide?.getAttribute('data-permalink') ?? '/the-lighter-side';
        const title = slide?.getAttribute('data-share-title') ?? 'Funny Bizz | Murtaza Insights';
        return {
          title,
          url: new URL(path, window.location.origin).toString()
        };
      };

      const refreshShareMenu = () => {
        const { title, url } = activeShareData();
        const encodedUrl = encodeURIComponent(url);
        const encodedTitle = encodeURIComponent(title);
        const setHref = (selector, href) => carousel.querySelector(selector)?.setAttribute('href', href);
        setHref('[data-share-facebook]', `https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`);
        setHref('[data-share-whatsapp]', `https://wa.me/?text=${encodedTitle}%20${encodedUrl}`);
        setHref('[data-share-linkedin]', `https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`);
        setHref('[data-share-x]', `https://twitter.com/intent/tweet?text=${encodedTitle}&url=${encodedUrl}`);
        setHref('[data-share-email]', `mailto:?subject=${encodedTitle}&body=${encodedTitle}%0A${encodedUrl}`);
      };

      const show = (index) => {
        if (!slides.length || index < 0 || index >= slides.length) return;
        current = index;

        slides.forEach((slide, i) => {
          slide.classList.toggle('active', i === current);
          slide.setAttribute('aria-hidden', i === current ? 'false' : 'true');
        });

        panels.forEach((panel, i) => {
          panel.classList.toggle('active', i === current);
          panel.setAttribute('aria-hidden', i === current ? 'false' : 'true');
        });

        const sequencePosition = sequence.indexOf(current);
        dotButtons.forEach((dot, i) => dot.classList.toggle('active', i === sequencePosition));

        archiveButtons.forEach((button) => {
          const itemIndex = Number(button.getAttribute('data-archive-index'));
          const active = itemIndex === current;
          button.classList.toggle('active', active);
          button.setAttribute('aria-current', active ? 'true' : 'false');
        });

        if (status) {
          status.textContent = sequencePosition >= 0
            ? `Slide ${sequencePosition + 1} of ${sequence.length}`
            : 'From the Archive';
        }

        if (commentaryViewport instanceof HTMLElement) commentaryViewport.scrollTop = 0;
        if (shareMenu instanceof HTMLElement) shareMenu.hidden = true;
        if (copyStatus) copyStatus.textContent = '';
        refreshShareMenu();
      };

      const stepSequence = (direction) => {
        if (!sequence.length) return;
        const position = sequence.indexOf(current);
        const targetPosition = position >= 0
          ? (position + direction + sequence.length) % sequence.length
          : direction > 0 ? 0 : sequence.length - 1;
        show(sequence[targetPosition]);
      };

      const scrollViewerIntoView = () => {
        const slider = document.getElementById('funny-slider');
        if (!slider) return;
        const header = document.querySelector('.topbar');
        const headerHeight = header instanceof HTMLElement ? header.offsetHeight : 76;
        const top = window.scrollY + slider.getBoundingClientRect().top - headerHeight - 8;
        window.scrollTo({ top: Math.max(0, top), behavior: 'smooth' });
      };

      sequence = buildSequence();
      rebuildDots();

      carousel.querySelector('[data-prev]')?.addEventListener('click', () => stepSequence(-1));
      carousel.querySelector('[data-next]')?.addEventListener('click', () => stepSequence(1));

      carousel.querySelectorAll('[data-next-image]').forEach((button) => {
        button.addEventListener('click', (event) => {
          if (ignoreNextClick) {
            event.preventDefault();
            return;
          }
          stepSequence(1);
        });
      });

      carousel.querySelectorAll('[data-destination-link]').forEach((link) => {
        link.addEventListener('click', (event) => {
          if (ignoreNextClick) event.preventDefault();
        });
      });

      screen?.addEventListener('touchstart', (event) => {
        touchStartX = event.changedTouches[0]?.clientX ?? 0;
        ignoreNextClick = false;
      }, { passive: true });

      screen?.addEventListener('touchend', (event) => {
        const touchEndX = event.changedTouches[0]?.clientX ?? touchStartX;
        const distance = touchEndX - touchStartX;
        if (Math.abs(distance) > 45) {
          ignoreNextClick = true;
          stepSequence(distance < 0 ? 1 : -1);
          window.setTimeout(() => { ignoreNextClick = false; }, 350);
        }
      }, { passive: true });

      archiveButtons.forEach((button) => {
        button.addEventListener('click', () => {
          const index = Number(button.getAttribute('data-archive-index'));
          if (!Number.isFinite(index)) return;
          show(index);
          scrollViewerIntoView();
        });
      });

      shareButton?.addEventListener('click', async () => {
        const { title, url } = activeShareData();
        if (navigator.share) {
          try {
            await navigator.share({ title, text: title, url });
            return;
          } catch (error) {
            if (error instanceof DOMException && error.name === 'AbortError') return;
          }
        }
        if (shareMenu instanceof HTMLElement) {
          refreshShareMenu();
          shareMenu.hidden = !shareMenu.hidden;
        }
      });

      copyButton?.addEventListener('click', async () => {
        const { url } = activeShareData();
        try {
          await navigator.clipboard.writeText(url);
          if (copyStatus) copyStatus.textContent = 'Link copied';
        } catch {
          window.prompt('Copy this item link:', url);
        }
      });

      const requestedId = new URLSearchParams(window.location.search).get('meme');
      const requestedIndex = requestedId
        ? slides.findIndex((slide) => slide.getAttribute('data-item-id') === requestedId)
        : -1;

      if (requestedIndex >= 0) {
        show(requestedIndex);
      } else if (sequence.length) {
        show(sequence[0]);
      } else {
        refreshShareMenu();
      }

      if (window.location.hash === '#funny-slider') {
        window.requestAnimationFrame(() => scrollViewerIntoView());
      }
    }
  </script>
</Base>
