---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ArticleCard from '../components/ArticleCard.astro';
const categories = ['Business Performance Reviews', 'Business Analysis & Strategy', 'Information Systems & Process Improvement'];
const categoryDescriptions: Record<string, string> = {
  'Business Performance Reviews': 'Independent assessments that look past reported profit to what a business is really delivering: cash generation, return on the capital employed, operational efficiency and whether the results can be sustained.',
  'Business Analysis & Strategy': 'Commentary on developments, competitive pressures and market trends, and what they mean for owner-managed businesses: the opportunities, the risks and the choices they put in front of management.',
  'Information Systems & Process Improvement': 'How systems, processes and new technology, AI included, can give management better information, make operations more efficient and support better decisions.',
};
const posts = (await getCollection('posts')).filter(post => !post.data.draft && !post.data.advertorial).sort((a,b) => +b.data.date - +a.data.date);
---
<Base title="Insights | Murtaza Insights">
<section class="page-head wrap"><p class="eyebrow">Insights</p><h1>Insights</h1><p>Practical analysis of business performance, management decisions, systems, processes and technology.</p></section>
{categories.filter(category => posts.some(post => post.data.category === category)).map(category => { const categoryPosts = posts.filter(post => post.data.category === category); return <section class="section wrap listing archive-list insights-category" aria-label={category}><div class="section-heading"><div><h2>{category}</h2>{categoryDescriptions[category] && <p>{categoryDescriptions[category]}</p>}</div></div>{categoryPosts.map(post => <ArticleCard post={post} compact hideCategory />)}</section>; })}
</Base>

<style is:global>
  #content .insights-category .section-heading p { max-width: 72ch; }
  @media (max-width: 760px) {
    #content .insights-category .section-heading { margin-block: 0 .6rem; }
    #content .insights-category .section-heading p { font-size: 1rem; line-height: 1.45; margin: .35rem 0 0; }
    #content .insights-category .archive-card {
      grid-template-columns: clamp(72px, 24vw, 104px) minmax(0, 1fr);
      gap: .35rem .75rem;
      padding-block: .85rem;
    }
    #content .insights-category .archive-card .archive-thumb { width: 100%; height: auto; aspect-ratio: auto; }
    #content .insights-category .archive-thumb img { display: block; height: auto; }
    #content .insights-category .archive-copy { display: contents; }
    #content .insights-category .archive-thumb { grid-area: 1 / 1 / 3 / 2; }
    #content .insights-category .archive-card .eyebrow { grid-area: 1 / 2; font-size: .8rem; }
    #content .insights-category .archive-copy h2 { grid-area: 2 / 2; font-size: 1.125rem; line-height: 1.25; margin: 0; overflow-wrap: anywhere; }
    #content .insights-category .archive-card { grid-template-rows: auto 1fr; }
    #content .insights-category .archive-summary,
    #content .insights-category .archive-copy .read { grid-column: 1 / -1; }
    #content .insights-category .archive-card .archive-summary { font-size: 1rem; line-height: 1.45; margin: .15rem 0; }
  }
</style>
