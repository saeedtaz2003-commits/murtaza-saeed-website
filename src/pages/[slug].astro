---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.filter(p => !p.data.draft).map(post => ({ params: { slug: post.data.slug }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
const pageUrl = new URL(Astro.url.pathname, Astro.site).toString();
const shareTitle = encodeURIComponent(post.data.title);
const shareUrl = encodeURIComponent(pageUrl);
const pageTitle = post.data.seoTitle ?? post.data.title;
const pageDescription = post.data.metaDescription ?? post.data.summary;
const isAdvertorial = post.data.advertorial;
const archiveHref = isAdvertorial ? '/advertorials#published-advertorials' : '/articles';
const archiveLabel = isAdvertorial ? 'View All Advertorials' : 'View All Articles';
const shareLabel = isAdvertorial ? 'Share this advertorial' : 'Share this article';
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': isAdvertorial ? 'AdvertiserContentArticle' : 'Article',
  headline: pageTitle,
  description: pageDescription,
  datePublished: post.data.date.toISOString(),
  dateModified: '2026-09-23T00:00:00.000Z',
  mainEntityOfPage: pageUrl,
  image: new URL(post.data.image, Astro.site).toString(),
  author: {
    '@type': 'Person',
    name: 'Murtaza Saeed',
    url: new URL('/about', Astro.site).toString(),
    description: 'Chartered Accountant, former CFM and independent finance and business commentator.'
  },
  publisher: {
    '@type': 'Organization',
    name: 'Murtaza Saeed | Finance & Business Insights',
    url: new URL('/', Astro.site).toString()
  },
  sponsor: isAdvertorial && post.data.sponsor ? {
    '@type': 'Organization',
    name: post.data.sponsor
  } : undefined
};
---
<Base title={`${pageTitle} | Murtaza Saeed`} description={pageDescription} image={post.data.image} type="article" jsonLd={articleSchema}>
  <article class="article wrap">
    <header class="article-header">
      <p class="eyebrow">
        {isAdvertorial ? <><a href="/advertorials">ADVERTORIAL</a> · {post.data.category}</> : <a href={`/${post.data.category.toLowerCase().replaceAll(' & ', '-').replaceAll(' ', '-')}`}>{post.data.category}</a>}
        {' · '}{post.data.date.toLocaleDateString('en-GB', { day:'numeric', month:'long', year:'numeric' })}
      </p>
      <h1>{post.data.title}</h1><p class="dek">{post.data.summary}</p>
    </header>
    {isAdvertorial && (
      <aside class="article-advertorial-disclosure" aria-label="Advertorial disclosure">
        <strong>ADVERTORIAL</strong>
        <p>{post.data.sponsor
          ? <>This advertorial was commissioned by {post.data.sponsor} and prepared in collaboration with the company. It is promotional content and is separate from the independent articles, analysis and commentary published on <em>Murtaza Insights</em>.</>
          : <>This is promotional content and is separate from the independent articles, analysis and commentary published on <em>Murtaza Insights</em>.</>}
        </p>
      </aside>
    )}
    <img class="article-image" src={post.data.image} alt={post.data.imageAlt} />
    {post.data.takeaways && <section class="at-a-glance" aria-labelledby="glance-title"><p class="eyebrow" id="glance-title">At a glance</p><ul>{post.data.takeaways.map(item => <li>{item}</li>)}</ul></section>}
    {post.data.toc && <details class="mobile-toc"><summary>In this article</summary><nav aria-label="Article contents">{post.data.toc.map(item => <a href={`#${item.id}`}>{item.label}</a>)}</nav></details>}
    <div class="article-grid">
      {post.data.toc && <aside class="article-toc"><p>In this article</p><nav aria-label="Article contents">{post.data.toc.map(item => <a href={`#${item.id}`}>{item.label}</a>)}</nav></aside>}
      <div class="prose"><Content />
        <div
          class="share share-end article-share"
          aria-label={shareLabel}
          data-content-share
          data-share-title={post.data.title}
          data-share-url={pageUrl}
        >
          <span>{shareLabel}</span>
          <button type="button" data-share-trigger>Share</button>
          <button type="button" data-copy-link>Copy link</button>
          <div class="article-share-fallback" data-share-fallback hidden aria-label="Share options">
            <a href={`https://www.facebook.com/sharer/sharer.php?u=${shareUrl}`} target="_blank" rel="noopener">Facebook</a>
            <a href={`https://wa.me/?text=${shareTitle}%20${shareUrl}`} target="_blank" rel="noopener">WhatsApp</a>
            <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${shareUrl}`} target="_blank" rel="noopener">LinkedIn</a>
            <a href={`https://twitter.com/intent/tweet?text=${shareTitle}&url=${shareUrl}`} target="_blank" rel="noopener">X</a>
            <a href={`mailto:?subject=${shareTitle}&body=${shareUrl}`}>Email</a>
          </div>
          <small class="article-share-status" data-share-status aria-live="polite"></small>
        </div>
        <div class="author-note"><img src="/images/murtaza-saeed-profile-web.jpg" alt="Murtaza Saeed" width="72" height="72" /><p>Written by <strong>Murtaza Saeed</strong><br /><span>Finance & Business Insights</span></p></div>
        <div class="article-view-all"><a class="button" href={archiveHref}>{archiveLabel}</a></div>
      </div>
    </div>
  </article>
  <script>
    document.querySelectorAll('[data-content-share]').forEach((container) => {
      if (!(container instanceof HTMLElement)) return;
      const shareButton = container.querySelector('[data-share-trigger]');
      const copyButton = container.querySelector('[data-copy-link]');
      const fallback = container.querySelector('[data-share-fallback]');
      const status = container.querySelector('[data-share-status]');
      const title = container.dataset.shareTitle || document.title;
      const url = container.dataset.shareUrl || location.href;

      shareButton?.addEventListener('click', async () => {
        if (navigator.share) {
          try {
            await navigator.share({ title, url });
            return;
          } catch (error) {
            if (error instanceof DOMException && error.name === 'AbortError') return;
          }
        }
        if (fallback instanceof HTMLElement) fallback.hidden = !fallback.hidden;
      });

      copyButton?.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(url);
          if (status) status.textContent = 'Link copied';
          if (copyButton instanceof HTMLButtonElement) {
            const original = copyButton.textContent;
            copyButton.textContent = 'Copied';
            window.setTimeout(() => { copyButton.textContent = original; }, 1600);
          }
        } catch {
          if (status) status.textContent = 'Copy unavailable — use Share instead';
        }
      });
    });

    document.querySelectorAll('.mobile-toc a').forEach(link => link.addEventListener('click', () => link.closest('details')?.removeAttribute('open')));
    const tocLinks = [...document.querySelectorAll('.article-toc a')];
    const sections = tocLinks.map(link => document.querySelector(link.getAttribute('href'))).filter(Boolean);
    const observer = new IntersectionObserver(entries => entries.forEach(entry => {
      if (entry.isIntersecting) {
        tocLinks.forEach(link => link.classList.toggle('active', link.getAttribute('href') === `#${entry.target.id}`));
      }
    }), { rootMargin: '-20% 0px -70% 0px' });
    sections.forEach(section => observer.observe(section));
  </script>
  <style>
    .article-share-fallback {
      width: 100%;
      display: flex;
      flex-wrap: wrap;
      gap: 0.8rem 1rem;
      padding: 0.75rem 0.9rem;
      border: 1px solid var(--line);
      border-radius: 0.45rem;
      background: var(--wash);
    }
    .article-share-fallback[hidden] {
      display: none;
    }
    .article-share-status {
      width: 100%;
      min-height: 1.2em;
      color: var(--muted);
      font-size: 0.78rem;
    }
  </style>
</Base>
