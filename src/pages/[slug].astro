---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import ContentEngagement from '../components/ContentEngagement.astro';
import WhatsAppAlerts from '../components/WhatsAppAlerts.astro';
export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.filter(p => !p.data.draft).map(post => ({ params: { slug: post.data.slug }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
const pageUrl = new URL(Astro.url.pathname, Astro.site).toString();
const pageTitle = post.data.seoTitle ?? post.data.title;
const pageDescription = post.data.metaDescription ?? post.data.summary;
const isAdvertorial = post.data.advertorial;
const archiveHref = isAdvertorial ? '/advertorials#published-advertorials' : '/insights';
const archiveLabel = isAdvertorial ? 'View All Advertorials' : 'View Insights';
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': isAdvertorial ? 'AdvertiserContentArticle' : 'Article',
  headline: pageTitle,
  description: pageDescription,
  datePublished: post.data.date.toISOString(),
  dateModified: '2026-09-23T00:00:00.000Z',
  mainEntityOfPage: pageUrl,
  image: new URL(post.data.image, Astro.site).toString(),
  author: {
    '@type': 'Person',
    name: 'Murtaza Saeed',
    url: new URL('/about', Astro.site).toString(),
    description: 'Former Chief Finance Manager and remote finance and business advisor who qualified as a Chartered Accountant earlier in his career.'
  },
  publisher: {
    '@type': 'Organization',
    name: 'Murtaza Saeed | Finance & Business Insights',
    url: new URL('/', Astro.site).toString()
  },
  sponsor: isAdvertorial && post.data.sponsor ? {
    '@type': 'Organization',
    name: post.data.sponsor
  } : undefined
};
---
<Base title={`${pageTitle} | Murtaza Saeed`} description={pageDescription} image={post.data.image} type="article" jsonLd={articleSchema}>
  <article class="article wrap">
    <header class="article-header">
      <p class="eyebrow">
        {isAdvertorial ? <><a href="/editorials">ADVERTORIAL</a> · {post.data.category}</> : <a href="/insights">{post.data.category}</a>}
        {' · '}{post.data.date.toLocaleDateString('en-GB', { day:'numeric', month:'long', year:'numeric' })}
      </p>
      <h1>{post.data.title}</h1><p class="dek">{post.data.summary}</p>
    </header>
    {isAdvertorial && (
      <aside class="article-advertorial-disclosure" aria-label="Advertorial disclosure">
        <strong>ADVERTORIAL</strong>
        <p>{post.data.sponsor
          ? <>This advertorial was commissioned by {post.data.sponsor} and prepared in collaboration with the company. It is promotional content and is separate from the independent articles, analysis and commentary published on <em>Murtaza Insights</em>.</>
          : <>This is promotional content and is separate from the independent articles, analysis and commentary published on <em>Murtaza Insights</em>.</>}
        </p>
      </aside>
    )}
    <img class="article-image" src={post.data.image} alt={post.data.imageAlt} />
    {post.data.takeaways && <section class="at-a-glance" aria-labelledby="glance-title"><p class="eyebrow" id="glance-title">At a glance</p><ul>{post.data.takeaways.map(item => <li>{item}</li>)}</ul></section>}
    {post.data.toc && <details class="mobile-toc"><summary>In this article</summary><nav aria-label="Article contents">{post.data.toc.map(item => <a href={`#${item.id}`}>{item.label}</a>)}</nav></details>}
    <div class="article-grid">
      {post.data.toc && <aside class="article-toc"><p>In this article</p><nav aria-label="Article contents">{post.data.toc.map(item => <a href={`#${item.id}`}>{item.label}</a>)}</nav></aside>}
      <div class="prose"><Content />
        {post.data.slug === "quickmart-ipo-what-price-should-you-pay" && <WhatsAppAlerts topic="QuickMart IPO" />}
        <ContentEngagement title={post.data.title} commentTitle={post.data.title} url={pageUrl} commentLast={post.data.slug === 'quickmart-ipo-what-price-should-you-pay'} class="article-engagement" />
        {post.data.slug === 'quickmart-ipo-what-price-should-you-pay' && <aside class="article-help-card">
          <h2>HOW I CAN HELP</h2><h3>Need an independent financial view?</h3>
          <p>Sometimes the challenge is not getting more information — it is making sense of the numbers and understanding what they mean for the decision in front of you.</p>
          <ul><li>Financial analysis and interpretation</li><li>Cash-flow and working-capital reviews</li><li>Budgeting and forecasting</li><li>Valuation and scenario analysis</li><li>Management reporting</li><li>Business-performance reviews</li><li>Independent assessment of business plans, transactions and investment proposals</li></ul>
          <p>Remote finance assignments and project-based advisory work are available, particularly where experienced financial judgement is needed without adding a full-time senior finance role.</p>
          <a class="button" href="https://forms.gle/HPmku2CCPTfA9mwv9" target="_blank" rel="noopener noreferrer">DISCUSS A PROJECT</a>
        </aside>}
        <div class="author-note"><img src="/images/murtaza-saeed-profile-web.jpg" alt="Murtaza Saeed" width="72" height="72" /><p>Written by <strong>Murtaza Saeed</strong><br /><span>Finance & Business Insights</span></p></div>
        <div class="article-view-all"><a class="button" href={archiveHref}>{archiveLabel}</a></div>
      </div>
    </div>
  </article>
  <script>
    document.querySelectorAll('.mobile-toc a').forEach(link => link.addEventListener('click', () => link.closest('details')?.removeAttribute('open')));
    const tocLinks = [...document.querySelectorAll('.article-toc a')];
    const sections = tocLinks.map(link => document.querySelector(link.getAttribute('href'))).filter(Boolean);
    const observer = new IntersectionObserver(entries => entries.forEach(entry => {
      if (entry.isIntersecting) {
        tocLinks.forEach(link => link.classList.toggle('active', link.getAttribute('href') === `#${entry.target.id}`));
      }
    }), { rootMargin: '-20% 0px -70% 0px' });
    sections.forEach(section => observer.observe(section));
  </script>
</Base>
