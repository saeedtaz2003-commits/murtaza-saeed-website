---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { previewExcerpt } from '../utils/article-preview.mjs';
import ContentEngagement from '../components/ContentEngagement.astro';
import WhatsAppAlerts from '../components/WhatsAppAlerts.astro';
import RelatedArticles from '../components/RelatedArticles.astro';
import BrandText from '../components/BrandText.astro';
import ArticleSources from '../components/ArticleSources.astro';
export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.filter(p => !p.data.draft).map(post => ({ params: { slug: post.data.slug }, props: { post } }));
}
const { post } = Astro.props;
const { articleHero } = post.data;
const heroBeforeTitle = Boolean(articleHero) || post.data.heroBeforeTitle;
const { Content, headings } = await render(post);
const toc = post.data.toc ?? headings.filter(heading => heading.depth === 2).map(heading => ({ id: heading.slug, label: heading.text }));
const pageUrl = new URL(Astro.url.pathname, Astro.site).toString();
const pageTitle = post.data.seoTitle ?? post.data.title;
const pageDescription = post.data.metaDescription ?? previewExcerpt(post);
const isAdvertorial = post.data.advertorial;
const isBudgetArticle = post.data.slug === 'should-your-budget-be-based-on-your-ambitious-sales-target';
const isMbappeArticle = post.data.slug === 'mbappe-endorsement-to-ownership';
const documentTitle = `${pageTitle} | ${isMbappeArticle ? 'Murtaza Insights' : 'Murtaza Saeed'}`;
const assignmentInvitation = 'Looking for an independent perspective on business performance, strategy or systems improvement?';
const archiveHref = isAdvertorial ? '/advertorials#published-advertorials' : '/insights/';
const archiveLabel = isAdvertorial ? 'View All Advertorials' : 'View Insights';
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': isAdvertorial ? 'AdvertiserContentArticle' : 'Article',
  headline: isMbappeArticle ? post.data.title : pageTitle,
  articleSection: post.data.category,
  description: pageDescription,
  datePublished: post.data.date.toISOString(),
  dateModified: (post.data.updated ?? post.data.date).toISOString(),
  mainEntityOfPage: pageUrl,
  image: new URL(post.data.image, Astro.site).toString(),
  author: {
    '@type': 'Person',
    '@id': new URL('/about/#person', Astro.site).toString(),
    name: 'Murtaza Saeed',
    url: new URL('/about/', Astro.site).toString(),
    sameAs: ['https://linkedin.com/in/murtaza-saeed'],
    description: 'Former Chief Finance Manager and remote business advisor who qualified as a Chartered Accountant earlier in his career.'
  },
  publisher: {
    '@type': 'Organization',
    name: 'Murtaza Saeed | Business, Management & Systems Insights',
    url: new URL('/', Astro.site).toString()
  },
  sponsor: isAdvertorial && post.data.sponsor ? {
    '@type': 'Organization',
    name: post.data.sponsor
  } : undefined
};
---
<Base title={documentTitle} description={pageDescription} image={isBudgetArticle ? '/images/budget-sales-target-share-v1.jpg' : post.data.image} imageAlt={post.data.imageAlt} imageWidth={isBudgetArticle ? 1200 : undefined} imageHeight={isBudgetArticle ? 630 : undefined} type="article" jsonLd={articleSchema}>
  <article class="article wrap">
    {heroBeforeTitle && <img class="article-hero-first" src={articleHero?.image ?? post.data.image} alt={articleHero?.alt ?? post.data.imageAlt} width={articleHero?.width} height={articleHero?.height} />}
    <header class="article-header">
      <p class="eyebrow">
        {isAdvertorial ? <><a href="/editorials">ADVERTORIAL</a> · {post.data.category}</> : <a href="/insights/">{post.data.category}</a>}
        {' · '}{post.data.updated ? 'Last updated: ' : 'Published: '}{(post.data.updated ?? post.data.date).toLocaleDateString('en-GB', { day:'numeric', month:'long', year:'numeric', timeZone:'UTC' })}
      </p>
      <h1>{post.data.title}</h1><p class="dek"><BrandText text={post.data.summary} /></p>
    </header>
    {isAdvertorial && (
      <aside class="article-advertorial-disclosure" aria-label="Advertorial disclosure">
        <strong>ADVERTORIAL</strong>
        <p>{post.data.sponsor
          ? <>This advertorial was commissioned by {post.data.sponsor} and prepared in collaboration with the company. It is promotional content and is separate from the independent articles, analysis and commentary published on <em>Murtaza Insights</em>.</>
          : <>This is promotional content and is separate from the independent articles, analysis and commentary published on <em>Murtaza Insights</em>.</>}
        </p>
      </aside>
    )}
    {!heroBeforeTitle && <img class="article-image" src={post.data.image} alt={post.data.imageAlt} />}
    {post.data.takeaways && <section class="at-a-glance" aria-labelledby="glance-title"><p class="eyebrow" id="glance-title">At a glance</p><ul>{post.data.takeaways.map(item => <li><BrandText text={item} /></li>)}</ul></section>}
    <div class="article-reading">
    {toc.length > 0 && <details class="mobile-toc contents-nav"><summary>In this article</summary><nav aria-label="Article contents">{toc.map(item => <a href={`#${item.id}`}>{item.label}</a>)}</nav></details>}
    <div class:list={["article-grid", { "article-grid-no-toc": !toc.length }]}>
      {toc.length > 0 && <aside class="article-toc contents-nav"><p>In this article</p><nav aria-label="Article contents">{toc.map(item => <a href={`#${item.id}`}>{item.label}</a>)}</nav></aside>}
      <div class="prose"><Content />
    <ArticleSources sources={post.data.sources} title={post.data.sourcesTitle} />
    <div class="article-actions">
      {!post.data.bodyHasInvitation && <p class="assignment-invitation">{assignmentInvitation}</p>}
      <p class="primary-article-action"><a class="button" href="https://forms.gle/AWvix79y4bZUg7rQ6" target="_blank" rel="noopener noreferrer">Discuss an Assignment</a></p>
      <ContentEngagement title={post.data.title} commentTitle={post.data.title} url={pageUrl} shareImage={isBudgetArticle ? '/images/budget-sales-target-share-v1.jpg' : post.data.image} class="article-engagement" />
      <WhatsAppAlerts topic="Updates" />
    </div>
      </div>
    </div>
    </div>
    <RelatedArticles currentSlug={post.data.slug} category={post.data.category} />
    <div class="author-note"><img src="/images/murtaza-saeed-profile-web.jpg" alt="Murtaza Saeed" width="72" height="72" /><p>Written by <strong>Murtaza Saeed</strong><br /><span>Business, Management & Systems Insights</span></p><a class="button author-insights" href="/insights/">More Insights</a></div>
    {isAdvertorial && <div class="article-view-all"><a class="button" href={archiveHref}>{archiveLabel}</a></div>}
  </article>
  <style>
    .article-hero-first { display: block; width: min(900px, 100%); height: auto; margin: 0 auto 2rem; }
  </style>
  <script>
    import { initSectionNavigation } from '../scripts/section-navigation';
    initSectionNavigation('.article-toc a');
    document.querySelectorAll('.mobile-toc a').forEach(link => link.addEventListener('click', () => link.closest('details')?.removeAttribute('open')));
    const tocLinks = [...document.querySelectorAll('.article-toc a')];
    const sections = tocLinks.map(link => document.getElementById(decodeURIComponent(link.getAttribute('href').slice(1)))).filter(Boolean);
    const observer = new IntersectionObserver(entries => entries.forEach(entry => {
      if (entry.isIntersecting) {
        tocLinks.forEach(link => link.classList.toggle('active', link.getAttribute('href') === `#${entry.target.id}`));
      }
    }), { rootMargin: '-20% 0px -70% 0px' });
    sections.forEach(section => observer.observe(section));
  </script>
</Base>

