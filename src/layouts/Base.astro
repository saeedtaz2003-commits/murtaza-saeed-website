---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import '../styles/site-updates.css';
import '../styles/funny-bizz-viewer.css';
import '../styles/funny-bizz-mixed-slider.css';
import '../styles/funny-bizz-mobile-size-fix.css';
import '../styles/site-spacing-tighten.css';
import '../styles/site-typography-rebalance.css';
import '../styles/approved-completion.css';
import '../styles/copyright.css';
import '../styles/immediate-fixes.css';
import '../styles/oct4-updates.css';
const { title = 'Murtaza Saeed | Business, Management & Technology Insights', description = 'Independent business, finance and technology commentary by Murtaza Saeed, shaped by more than 35 years of professional experience.', image = '/images/murtaza-insights-full-logo-canonical.png', type = 'website', jsonLd } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(image, Astro.site);
const { imageAlt, imageWidth, imageHeight } = Astro.props;
const socialPath = socialImage.pathname.toLowerCase();
const socialImageType = socialPath.endsWith('.webp')
  ? 'image/webp'
  : socialPath.endsWith('.jpg') || socialPath.endsWith('.jpeg')
    ? 'image/jpeg'
    : socialPath.endsWith('.png')
      ? 'image/png'
      : undefined;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:secure_url" content={socialImage} />
    {socialImageType && <meta property="og:image:type" content={socialImageType} />}
    {imageAlt && <meta property="og:image:alt" content={imageAlt} />}
    {imageWidth && <meta property="og:image:width" content={imageWidth} />}
    {imageHeight && <meta property="og:image:height" content={imageHeight} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    {imageAlt && <meta name="twitter:image:alt" content={imageAlt} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="skip" href="#content">Skip to content</a>
    <Header />
    <main id="content"><slot /></main>
    <Footer />
    <script>
      document.querySelectorAll('[data-content-share]').forEach((container) => {
        if (!(container instanceof HTMLElement) || container.dataset.shareReady === 'true') return;
        container.dataset.shareReady = 'true';
        const shareButton = container.querySelector('[data-share-trigger]');
        const copyButton = container.querySelector('[data-copy-link]');
        const fallback = container.querySelector('[data-share-fallback]');
        const status = container.querySelector('[data-share-status]');
        const title = container.dataset.shareTitle || document.title;
        const url = container.dataset.shareUrl || location.href;

        shareButton?.addEventListener('click', async () => {
          if (navigator.share) {
            try {
              await navigator.share({ title, text: title, url });
              return;
            } catch (error) {
              if (error instanceof DOMException && error.name === 'AbortError') return;
            }
          }
          if (fallback instanceof HTMLElement) fallback.hidden = !fallback.hidden;
        });

        copyButton?.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(url);
            if (status) status.textContent = 'Link copied';
            if (copyButton instanceof HTMLButtonElement) {
              const original = copyButton.textContent;
              copyButton.textContent = 'Copied';
              window.setTimeout(() => { copyButton.textContent = original; }, 1600);
            }
          } catch {
            if (status) status.textContent = 'Copy unavailable — use Share instead';
          }
        });
      });
    </script>
  </body>
</html>
